{
  "name": "@jbhirsh/ci",
  "private": true,
  "type": "module",
  "description": "Shared CI tooling for jbhirsh/fog-and-frontier, jbhirsh/sift and jbhirsh/BoardGames",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint . && node lint/actions.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-jsdoc": "^63.3.3",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "jsdom": "^27.4.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "typescript": "~6.0.2",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  }
}
