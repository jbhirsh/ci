{
  "name": "@jbhirsh/ci",
  "private": true,
  "type": "module",
  "description": "Shared CI tooling for jbhirsh/fog-and-frontier, jbhirsh/sift and jbhirsh/BoardGames",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "node node_modules/typescript/bin/tsc -p tsconfig.json",
    "lint": "eslint . && node lint/actions.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "@typescript/typescript6": "^6.0.2",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-plugin-jsdoc": "^65.4.5",
    "fast-check": "^4.10.2",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "playwright": "^1.65.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0"
  }
}
