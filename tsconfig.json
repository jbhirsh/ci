{
  "compilerOptions": {
    // For the one JavaScript file, eslint.config.js, typed in JSDoc.
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    // Node 24 runs a .ts file by stripping its types, with no build: a
    // relative import names the file as Node loads it (`./x.ts`), only
    // syntax Node can blank out is allowed (no enum, namespace or parameter
    // properties), and a type comes in by `import type`, never as a value
    // Node would look for at run time.
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["**/*.ts", "eslint.config.js"],
  "exclude": ["node_modules", "coverage", ".stryker-tmp"]
}
